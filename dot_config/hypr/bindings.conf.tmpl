# Application bindings
$terminal = uwsm app -- ghostty
$browser = uwsm app -- brave

# general binds
bindd = SUPER, W, Close window, killactive

# meta
bindm = SUPER, mouse:272, movewindow
bindm = SUPER, mouse:273, resizewindow

# apps
bindd = SUPER, RETURN, Terminal, exec, uwsm-app -- xdg-terminal-exec --dir="$(omarchy-cmd-terminal-cwd)"
bindd = SUPER SHIFT, RETURN, Tmux, exec, uwsm-app -- xdg-terminal-exec --dir="$(omarchy-cmd-terminal-cwd)" bash -c "tmux attach || tmux new -s Work"
bindd = SUPER SHIFT, B, Browser, exec, omarchy-launch-browser
bindd = SUPER SHIFT, F, File manager, exec, uwsm app -- nautilus --new-window
bindd = SUPER SHIFT ALT, B, Browser (private), exec, omarchy-launch-browser --private
bindd = SUPER SHIFT, M, Music, exec, omarchy-launch-or-focus spotify
bindd = SUPER SHIFT ALT, M, Music TUI, exec, omarchy-launch-or-focus-tui cliamp
bindd = SUPER SHIFT, N, Editor, exec, omarchy-launch-editor
bindd = CTRL SHIFT, escape, Activity, exec, omarchy-launch-tui btop
bindd = SUPER SHIFT, O, Obsidian, exec, omarchy-launch-or-focus obsidian "uwsm-app -- obsidian"
bindd = SUPER SHIFT, slash, Passwords, exec, uwsm app -- 1password
unbind = SUPER, P
bindd = SUPER, P, Project launcher, exec, uwsm app -- "$HOME/.local/bin/project_launcher"
bindd = SUPER SHIFT, Q, Toggle Quickshell, exec, "$HOME/.local/bin/toggle-quickshell"

# bindd = SUPER SHIFT, A, ChatGPT, exec, omarchy-launch-webapp "https://chatgpt.com"
bindd = SUPER SHIFT, Y, YouTube, exec, omarchy-launch-webapp "https://youtube.com/"

# Special workspace toggles
bind = SUPER, D, togglespecialworkspace, vesktop
bind = SUPER, M, togglespecialworkspace, music
bind = SUPER, odiaeresis, togglespecialworkspace, terminal #odiaeresis=Ö

{{- if .isLaptop }}
# XF86Launch8 <=> HP Programmable Key
bind = , XF86Launch8, exec, duck-dictate start
bindr = , XF86Launch8, exec, duck-dictate stop
{{- else if .isDesktop }}
bind = , F12, exec, uwsm app -- ~/.local/bin/duck-dictate start
bindr = , F12, exec, uwsm app -- ~/.local/bin/duck-dictate stop
{{- end }}

# Window rules so apps always spawn into their special workspace
# Vesktop (Discord client)
windowrule {
  name = windowrule-1
  workspace = special:vesktop
  match:class = ^(vesktop)$
}

windowrule {
  name = windowrule-2
  workspace = special:vesktop
  match:class = ^(Vesktop)$
}

# Spotify
windowrule {
  name = windowrule-3
  workspace = special:music
  match:class = ^(spotify)$
}

windowrule {
  name = windowrule-4
  workspace = special:music
  match:class = ^(Spotify)$
}

# Steam Big Picture Mode — override default float/size with fullscreen
windowrule {
  name = steam-big-picture
  fullscreen = 1
  match:class = ^(steam)$
  match:title = ^Steam Big Picture Mode$
}

# Vim-style focus movement
unbind = SUPER, H
unbind = SUPER, J
unbind = SUPER, K
unbind = SUPER, L
bind = SUPER, h, movefocus, l
bind = SUPER, j, movefocus, d
bind = SUPER, k, movefocus, u
bind = SUPER, l, movefocus, r

