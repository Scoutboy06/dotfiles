# See https://wiki.hyprland.org/Configuring/Monitors/
# List current monitors and resolutions possible: hyprctl monitors
# Format: monitor = [port], resolution, position, scale
# You must relaunch Hyprland after changing any envs (use Super+Esc, then Relaunch)

{{- if .isDesktop }}
# Desktop configuration
# Left monitor: 1080p (HDMI-A-1)
# Right monitor (primary): 1440p (DP-1)
# Alignment: left monitor's bottom-right touching right monitor's bottom-left

env = GDK_SCALE,1.25
monitor = HDMI-A-1, preferred, 0x0, 1
monitor = DP-1, 2560x1440@179.88, 1920x0, 1.25
# Additional monitors (add as needed)

{{- else if .isLaptop }}

# Laptop configuration (eliaslt)
# Built-in display with fractional scaling
env = GDK_SCALE,1.25
monitor = eDP-1, preferred, auto, {{ .monitorScale }}
# External monitors will be auto-configured
monitor = , preferred, auto, 1

{{- else }}

# Fallback: auto-configure all monitors
env = GDK_SCALE,1
monitor = , preferred, auto, 1

{{- end }}
