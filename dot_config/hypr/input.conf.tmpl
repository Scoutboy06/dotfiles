# Control your input devices
# See https://wiki.hypr.land/Configuring/Variables/#input
input {
  # Use multiple keyboard layouts and switch between them with Left Alt + Right Alt
  # kb_layout = us,dk,eu
  kb_layout = se

  # You can customize the bahavior of the Caps Lock key using kb_options
  # To view all available options related to Caps Lock, run:
  # grep 'caps' /usr/share/X11/xkb/rules/base.lst

  # Example, remap Caps lock to Ctrl:
  # kb_options = ctrl:nocaps
  # To swap Caps Lock and Escape:
  # kb_options = caps:swapescape
{{- if .isDesktop }}
  # Desktop: Caps Lock becomes an additional Escape key
  kb_options = caps:escape
{{- else if .isLaptop }}
  # Laptop: Use compose (original behavior)
  kb_options = compose:caps
{{- end }}

  # Change speed of keyboard repeat
  repeat_rate = 40
  repeat_delay = 250

  # Start with numlock on by default
  numlock_by_default = true

  # Increase sensitity for mouse/trackpack (default: 0)
  # sensitivity = 0.35

  touchpad {
    # Use natural (inverse) scrolling
    natural_scroll = true

    # Use two-finger clicks for right-click instead of lower-right corner
    clickfinger_behavior = true

    # Control the speed of your scrolling
    scroll_factor = 0.4
  }
}

# Scroll faster in the terminal
# windowrule = scrolltouchpad 1.2, tag:terminal
windowrule = match:class (Alacritty|kitty|foot), scroll_touchpad 1.5
windowrule = match:class com.mitchellh.ghostty, scroll_touchpad 0.2

# Enable touchpad gestures for changing workspaces
# See https://wiki.hyprland.org/Configuring/Gestures/
gesture = 3, horizontal, workspace
gesture = 3, swipe, mod:ALT, resize

