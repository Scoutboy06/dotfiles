[Unit]
Description=Check for new packages to persist (twice weekly)

[Timer]
# Run twice a week: Wednesday and Sunday at 10:00
OnCalendar=Wed,Sun 10:00
# Catch up if system was off during scheduled time
Persistent=true
# Add random delay up to 1 hour to avoid exact timing
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
