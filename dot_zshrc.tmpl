# chezmoi:template
# ~/.zshrc - Zsh configuration

# ----- History -----
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY          # Write timestamp to history
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicates first
setopt HIST_IGNORE_DUPS          # Don't record duplicates
setopt HIST_IGNORE_SPACE         # Don't record commands starting with space
setopt HIST_VERIFY               # Show command before executing from history
setopt SHARE_HISTORY             # Share history between sessions
setopt APPEND_HISTORY            # Append to history file

# ----- Directory navigation -----
setopt AUTO_CD                   # cd by typing directory name
setopt AUTO_PUSHD                # Push directory to stack on cd
setopt PUSHD_IGNORE_DUPS         # Don't push duplicates
setopt PUSHD_SILENT              # Don't print stack after pushd/popd
DIRSTACKSIZE=20

# ----- Completion -----
autoload -Uz compinit
compinit -C  # -C for faster startup (skip security check)

zstyle ':completion:*' menu select                       # Menu selection
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'     # Case insensitive
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}   # Colored completions
zstyle ':completion:*' group-name ''                     # Group completions
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches --%f'

# ----- Key bindings -----
bindkey -e                        # Emacs keybindings
bindkey '^[[A' history-search-backward  # Up arrow
bindkey '^[[B' history-search-forward   # Down arrow
bindkey '^[[H' beginning-of-line        # Home
bindkey '^[[F' end-of-line              # End
bindkey '^[[3~' delete-char             # Delete
bindkey '^[[1;5C' forward-word          # Ctrl+Right
bindkey '^[[1;5D' backward-word         # Ctrl+Left

# ----- Environment -----
export EDITOR="${EDITOR:-{{ .editor }}}"
export VISUAL="$EDITOR"
export PAGER="${PAGER:-less}"
export LESS='-R --mouse --wheel-lines=3'

# XDG directories
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Custom directories
export PROJECTS_DIR="${PROJECT_DIR:-$HOME/p}"

# PATH additions
typeset -U path  # Remove duplicates
path=(~/.local/bin $path)

# fnm
FNM_PATH="/home/elias/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "`fnm env --use-on-cd`"
fi

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# opencode
export PATH=/home/elias/.opencode/bin:$PATH

# LM Studio CLI (lms)
export PATH="$PATH:/home/elias/.lmstudio/bin"

# Cargo
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# Local environment
# . "$HOME/.local/share/../bin/env"

# ----- Aliases -----
# ls with colors (use eza if available)
if command -v eza &>/dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -l --icons --group-directories-first'
    alias la='eza -la --icons --group-directories-first'
    alias lt='eza --tree --icons --group-directories-first'
else
    alias ls='ls --color=auto'
    alias ll='ls -lh'
    alias la='ls -lah'
fi


# Safety aliases
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Shortcuts
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias g='git'
alias v='nvim'
alias vim='nvim'
alias svim='sudo -E nvim'
# Make zed and zeditor interchangeable regardless of which binary is installed
if command -v zeditor &>/dev/null; then
  alias zed='zeditor'
elif command -v zed &>/dev/null; then
  alias zeditor='zed'
fi
alias copy='wl-copy'
alias paste='wl-paste'
alias cc='claude'
alias ca='claude agents'

mkcd() {
  [ -z "$1" ] && { echo "Usage: mkcd <dir>"; return 1; }
  local dir="${1/#\~/$HOME}"
  mkdir -p "$dir" && cd "$dir"
}

# Git aliases
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline -20'
alias gp='git push'
alias gc='git commit'

# System
alias reload='source ~/.zshrc'
alias df='df -h'
alias du='du -h'
alias free='free -h'

# Chezmoi
alias cz='chezmoi'
alias cza='chezmoi-apply'
alias czd='chezmoi diff'
alias cze='chezmoi edit'

# Custom functions

# make claude, opencode, pi, use nono sandbox by default if installed
if [[ -z $NONO_CAP_FILE ]] && (( $+commands[nono] )); then
  claude()   { nono wrap -s --allow-cwd -p nolabs-ai/claude   --extends dotnet-dev -- claude   "$@" }
  opencode() { nono wrap -s --allow-cwd -p nolabs-ai/opencode --extends dotnet-dev -- opencode "$@" }
  pi()       { nono wrap -s --allow-cwd -p nolabs-ai/pi       --extends dotnet-dev -- pi       "$@" }
fi

o() {
  if [[ ! -f .env ]]; then
    echo "❌ .env not found in $(pwd)"
    return 1
  fi
  op run --env-file=.env -- "$@"
}

# Bitwarden: the session lives in a tmpfs cache, never in the shell environment.
typeset -g BW_CACHE_DIR="/dev/shm/bw-${UID}"
typeset -g BW_SESSION_CACHE="$BW_CACHE_DIR/session"
typeset -g BW_LOOKUP_CACHE="$BW_CACHE_DIR/lookup-ids"
typeset -g BW_VALUE_CACHE="$BW_CACHE_DIR/resolved-values"
[[ -d "$BW_CACHE_DIR" ]] || mkdir -m 700 -p -- "$BW_CACHE_DIR"
chmod 700 -- "$BW_CACHE_DIR"

bw() {
  local session=''
  [[ -r "$BW_SESSION_CACHE" ]] && session="$(<"$BW_SESSION_CACHE")"

  # BW_SESSION is passed to this one process only; it never enters the shell env.
  local -a run=(command bw)
  [[ -n "$session" ]] && run=(env "BW_SESSION=$session" bw)

  case "$1" in
    unlock)
      session=$(command bw unlock --raw "${@:2}") || return 1
      (umask 077; print -rn -- "$session" >| "$BW_SESSION_CACHE")
      chmod 600 -- "$BW_SESSION_CACHE"
      rm -f -- "$BW_LOOKUP_CACHE" "$BW_VALUE_CACHE"
      print 'Bitwarden vault unlocked for this WSL session.'
      ;;
    cache)
      if [[ "$2" == reset && $# -eq 2 ]]; then
        rm -f -- "$BW_LOOKUP_CACHE" "$BW_VALUE_CACHE"
        print 'Bitwarden caches reset.'
      else
        print -u2 'Usage: bw cache reset'
        return 1
      fi
      ;;
    lock|logout)
      rm -f -- "$BW_SESSION_CACHE" "$BW_LOOKUP_CACHE" "$BW_VALUE_CACHE"
      "${run[@]}" "$@"
      ;;
    sync)
      rm -f -- "$BW_LOOKUP_CACHE" "$BW_VALUE_CACHE"
      "${run[@]}" "$@"
      ;;
    *)
      "${run[@]}" "$@"
      ;;
  esac
}

inspect() {
  [ -z "$1" ] && { echo "Usage: inspect <command>"; return 1; }
  local target
  if ! target=$(which "$1"); then
    echo "$target"
    return 1
  fi

  if [[ -f "$target" ]]; then
    bat "$target"
  else
    echo "$target" | bat -l zsh
  fi
}

gitzip() {
  local dir="${1:?Usage: gitzip <directory> [zipname]}"
  local zipname="${2:-${dir%/}.zip}"
  [[ -d "$dir" ]] || { echo "❌ Not a directory: $dir"; return 1; }
  [[ -d "$dir/.git" ]] || { echo "❌ Not a git repo: $dir"; return 1; }
  git -C "$dir" ls-files --cached --others --exclude-standard -z |
    sed -z "s|^|${dir%/}/|" |
    xargs -0 zip "$zipname" &&
    echo "✅ Created $zipname ($(git -C "$dir" ls-files --cached --others --exclude-standard | wc -l) files)"
}

skills() {
  bunx skills "$@"
}

# ----- Integrations -----

# Starship prompt
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
fi

# zoxide (smarter cd)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# fzf
if command -v fzf &>/dev/null; then
    source <(fzf --zsh) 2>/dev/null || true
fi

# direnv
if command -v direnv &>/dev/null; then
    eval "$(direnv hook zsh)"
fi

# .ssh/config completion
zstyle -e ':completion:*:(ssh|scp):*:my-accounts' users-hosts \
  '_hosts "$@"; trap false EXIT; return 1'

# Syncthing
if command -v syncthing &>/dev/null; then
    eval "$(syncthing install-completions)"
fi

# ----- Local overrides -----
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
