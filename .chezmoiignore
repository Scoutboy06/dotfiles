AGENTS.md
README.md
CODE.md
session-*.md

# Build artifacts
**/__pycache__/**
**/*.pyc

# Systemd timer symlinks (managed by systemd enable/disable)
.config/systemd/user/timers.target.wants/

# Machine-specific ignores
{{ if not .isOmarchy }}
.config/nvim/lua/plugins/theme.lua
{{ end }}

{{ if not .isLaptop }}
# Desktop doesn't need laptop-specific configs
.config/eduroam/
.config/systemd/user/battery-monitor.service
.config/systemd/user/battery-monitor.timer
{{ end }}

{{ if not .isDesktop }}
# Work VPN access is only configured on the home PC
.config/systemd/user/work-vpn-proxy.service
.config/work-vpn-proxy/
.config/omarchy/plugins/elias.indicators/
.local/bin/work-vpn-proxy
{{ end }}
