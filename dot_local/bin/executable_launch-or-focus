#!/usr/bin/env bash

# launch-or-focus - Focus an existing window or launch the app if not running
#
# Usage:
#   launch-or-focus <class> [launch_command]
#
# If a window with the given class exists, focus it.
# Otherwise, run the launch command (defaults to the class name).
#
# Examples:
#   launch-or-focus spotify
#   launch-or-focus obsidian "uwsm app -- obsidian --disable-gpu"
#   launch-or-focus firefox "uwsm app -- firefox"

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: launch-or-focus <class> [launch_command]

Focus a window by class, or launch if not running.

Arguments:
  class          Window class to match (case-insensitive)
  launch_command Command to run if window not found (default: uwsm app -- <class>)

Examples:
  launch-or-focus spotify
  launch-or-focus obsidian "uwsm app -- obsidian --disable-gpu"
EOF
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

class="$1"
launch_cmd="${2:-uwsm app -- $class}"

# Check if a window with this class exists (case-insensitive match)
# hyprctl clients returns JSON with window info
if hyprctl clients -j | grep -qi "\"class\": \"$class\""; then
  # Window exists, focus it
  # Use hyprctl dispatch to focus by class
  hyprctl dispatch focuswindow "class:$class"
else
  # Window doesn't exist, launch the app
  eval "$launch_cmd" &
fi
