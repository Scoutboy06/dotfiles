#!/usr/bin/python3
"""
Ducks (temporarily lowers) the system (output) volume by a percentage when dictation starts,
and restores the volume when dictation ends. Works with PulseAudio or PipeWire.

- Usage: executable_duck-system-volume duck [--amount=0.2]
         executable_duck-system-volume restore
- Default "duck" factor is 0.2 (volume becomes 20% of current).
- Stores previous volume in /tmp/duck-system-volume-<user>
"""
import sys
import subprocess
import os
import getpass
import argparse

STATE_FILE = f"/tmp/duck-system-volume-{getpass.getuser()}"
DEFAULT_DUCK_FACTOR = 0.7  # Final = original * DUCK_FACTOR, i.e. set to 70% of current


def detect_backend():
    """Return 'pipewire' or 'pulseaudio' or raise if unsupported."""
    # Try wpctl (PipeWire)
    try:
        subprocess.run(["wpctl", "status"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        return "pipewire"
    except (FileNotFoundError, subprocess.CalledProcessError):
        pass
    # Try pactl (PulseAudio)
    try:
        pactl_info = subprocess.check_output(["pactl", "info"], stderr=subprocess.DEVNULL).decode()
        if "PulseAudio" in pactl_info or "pulseaudio" in pactl_info or "Server Name" in pactl_info:
            return "pulseaudio"
    except (FileNotFoundError, subprocess.CalledProcessError):
        pass
    sys.stderr.write("No supported audio backend found (PipeWire or PulseAudio).\n")
    sys.exit(1)


def get_volume(backend):
    if backend == "pipewire":
        # Example output: 'Volume: 0.70'
        out = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]).decode()
        words = out.split()
        for w in words:
            try:
                v = float(w)
                # Clamp for paranoia
                if 0 <= v <= 2:
                    return v
            except Exception:
                continue
        raise RuntimeError(f"Could not parse volume: {out}")
    elif backend == "pulseaudio":
        # Example: 'Volume: front-left: 28781 /  44% / -24.32 dB, front-right: 28781 /  44% / -24.32 dB'
        out = subprocess.check_output(["pactl", "get-sink-volume", "@DEFAULT_SINK@"]).decode()
        import re
        # Find first perc in line
        m = re.search(r"(\d{1,3})%", out)
        if not m:
            raise RuntimeError(f"Could not parse volume: {out}")
        return int(m.group(1)) / 100.0
    else:
        raise AssertionError(backend)


def set_volume(backend, value):
    if backend == "pipewire":
        value = min(max(value, 0.0), 1.5)  # Avoid accidentally blasting eardrums
        cmd = ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{value:.2f}"]
    elif backend == "pulseaudio":
        value = min(max(value, 0.0), 1.5)
        cmd = ["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{int(value * 100)}%"]
    else:
        raise AssertionError(backend)
    subprocess.run(cmd, check=True)


def duck(amount=DEFAULT_DUCK_FACTOR):
    backend = detect_backend()
    orig = get_volume(backend)
    newvol = max(round(orig * amount, 5), 0.0)
    set_volume(backend, newvol)
    # Save state
    with open(STATE_FILE, 'w') as f:
        f.write(f"{backend} {orig}\n")
    os.chmod(STATE_FILE, 0o600)


def restore():
    if not os.path.exists(STATE_FILE):
        # Nothing to do
        sys.exit(0)
    with open(STATE_FILE) as f:
        line = f.readline().strip()
    if not line:
        os.remove(STATE_FILE)
        sys.exit(0)
    backend, orig = line.split()
    orig = float(orig)
    # Check if current backend matches
    cur_backend = detect_backend()
    if cur_backend != backend:
        # Backend changed, likely new session/audio restart
        subprocess.run([
            "notify-send", "[Dictation Duck]", "Audio stack changed; not restoring volume."
        ])
        os.remove(STATE_FILE)
        sys.exit(0)
    set_volume(backend, orig)
    os.remove(STATE_FILE)


def main():
    parser = argparse.ArgumentParser(description="Temporarily duck (lower) system volume and restore later.")
    parser.add_argument('action', choices=['duck', 'restore'])
    parser.add_argument('--amount', type=float, help="Multiply volume by this (0.2=20%%, default)")
    args = parser.parse_args()
    if args.action == "duck":
        amount = args.amount if args.amount is not None else DEFAULT_DUCK_FACTOR
        if not (0.01 <= amount <= 1.0):
            parser.error("--amount must be between 0 and 1 (e.g. 0.2 for 20%)")
        duck(amount)
    elif args.action == "restore":
        restore()
    else:
        parser.error("unknown action")

if __name__ == "__main__":
    main()
