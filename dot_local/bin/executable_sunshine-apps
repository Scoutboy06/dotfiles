#!/usr/bin/env python3
import sys
import json
import argparse
from pathlib import Path

# Common Sunshine configuration path
SUNSHINE_CONFIG_DIR = Path.home() / ".config" / "sunshine"
DEFAULT_APPS_JSON = SUNSHINE_CONFIG_DIR / "apps.json"

def parse_args(argv: list[str] | None = None):
    parser = argparse.ArgumentParser(
        description="Integrate steam-apps output into Sunshine apps.json",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument(
        '-i', '--input',
        type=argparse.FileType('r'),
        default=sys.stdin,
        help="Input JSON (defaults to stdin, e.g. output from steam-apps)"
    )
    parser.add_argument(
        '-o', '--output',
        type=Path,
        help="Output JSON (defaults to stdout, can be apps.json)"
    )
    parser.add_argument(
        '-c', '--config',
        type=Path,
        default=DEFAULT_APPS_JSON,
        help="Base Sunshine apps.json to merge with"
    )
    parser.add_argument(
        '--dry-run',
        action='store_true',
        help="List games that would be added without writing JSON"
    )
    return parser.parse_args(argv)

def steam_app_id(app):
    """Return the Steam app ID from an existing Sunshine entry, if any."""
    prefix = "steam://rungameid/"
    for command in app.get("detached", []):
        if prefix in command:
            return command.split(prefix, 1)[1].split()[0].strip('"\'')
    return None


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    
    try:
        # 1. Read the base apps.json config
        base_config = {"env": {"PATH": "$(PATH):$(HOME)/.local/bin"}, "apps": []}
        if args.config.exists() and args.config.stat().st_size > 0:
            with open(args.config, 'r', encoding='utf-8') as f:
                try:
                    base_config = json.load(f)
                except json.JSONDecodeError:
                    base_config = {"env": {"PATH": "$(PATH):$(HOME)/.local/bin"}, "apps": []}
        
        if "apps" not in base_config:
            base_config["apps"] = []
            
        # 2. Read the steam-apps JSON input
        try:
            steam_games = json.load(args.input)
        except json.JSONDecodeError as e:
            print(f"Error parsing input JSON: {e}", file=sys.stderr)
            return 2
            
        # 3. Add only games that do not already have a Sunshine entry. Existing
        # entries are authoritative and remain byte-for-byte equivalent in the
        # resulting JSON data, including custom covers and launch settings.
        existing_ids = {
            app_id
            for app in base_config["apps"]
            if (app_id := steam_app_id(app)) is not None
        }
        games_to_add = [
            game for game in steam_games
            if str(game.get("id")) not in existing_ids
        ]

        if args.dry_run:
            if not games_to_add:
                print("No games would be added.")
            else:
                print(f"{len(games_to_add)} game(s) would be added:")
                for game in games_to_add:
                    print(f"  {game.get('name')} ({game.get('id')})")
            return 0

        # 4. Generate basic entries for missing Steam games.
        for game in games_to_add:
            app_entry = {
                "name": game.get("name"),
                "detached": [
                    f"setsid steam steam://rungameid/{game.get('id')}"
                ],
                "image-path": game.get("image", "")
            }

            if not app_entry["image-path"]:
                app_entry.pop("image-path")

            base_config["apps"].append(app_entry)
            existing_ids.add(str(game.get("id")))

        # 5. Output the merged JSON. Delay opening the output until now so
        # --dry-run can never truncate an existing file.
        if args.output:
            with open(args.output, 'w', encoding='utf-8') as output:
                json.dump(base_config, output, indent=2)
                output.write('\n')
        else:
            json.dump(base_config, sys.stdout, indent=2)
            sys.stdout.write('\n')
        
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
        
    return 0

if __name__ == '__main__':
    raise SystemExit(main())