#!/usr/bin/env python3
import sys
import json
import argparse
from pathlib import Path

# Common Sunshine configuration path
SUNSHINE_CONFIG_DIR = Path.home() / ".config" / "sunshine"
DEFAULT_APPS_JSON = SUNSHINE_CONFIG_DIR / "apps.json"

def parse_args():
    parser = argparse.ArgumentParser(
        description="Integrate steam-apps output into Sunshine apps.json",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument(
        '-i', '--input',
        type=argparse.FileType('r'),
        default=sys.stdin,
        help="Input JSON (defaults to stdin, e.g. output from steam-apps)"
    )
    parser.add_argument(
        '-o', '--output',
        type=argparse.FileType('w'),
        default=sys.stdout,
        help="Output JSON (defaults to stdout, can be redirected to apps.json)"
    )
    parser.add_argument(
        '-c', '--config',
        type=Path,
        default=DEFAULT_APPS_JSON,
        help="Base Sunshine apps.json to merge with"
    )
    return parser.parse_args()

def main(argv: list[str] | None = None) -> int:
    args = parse_args()
    
    try:
        # 1. Read the base apps.json config
        base_config = {"env": {"PATH": "$(PATH):$(HOME)/.local/bin"}, "apps": []}
        if args.config.exists():
            with open(args.config, 'r', encoding='utf-8') as f:
                base_config = json.load(f)
        
        if "apps" not in base_config:
            base_config["apps"] = []
            
        # 2. Read the steam-apps JSON input
        try:
            steam_games = json.load(args.input)
        except json.JSONDecodeError as e:
            print(f"Error parsing input JSON: {e}", file=sys.stderr)
            return 2
            
        # 3. Filter out existing Steam games from base config to avoid duplicates
        # Keep non-Steam apps (like Desktop, Steam Big Picture, etc)
        # We can identify Steam games because their launch command starts with steam://rungameid/
        filtered_apps = []
        for app in base_config["apps"]:
            is_steam_game = False
            
            # Check if this app was previously generated by this script
            detached_cmds = app.get("detached", [])
            for cmd in detached_cmds:
                if "steam://rungameid/" in cmd:
                    is_steam_game = True
                    break
                    
            if not is_steam_game:
                filtered_apps.append(app)
                
        base_config["apps"] = filtered_apps
        
        # 4. Generate new app entries for all Steam games
        for game in steam_games:
            app_entry = {
                "name": game.get("name"),
                "detached": [
                    f"setsid steam steam://rungameid/{game.get('id')}"
                ],
                "image-path": game.get("image", "")
            }
            
            # Only add to list if image path actually exists
            if not app_entry["image-path"]:
                app_entry.pop("image-path")
                
            base_config["apps"].append(app_entry)
            
        # 5. Output the merged JSON
        json.dump(base_config, args.output, indent=2)
        args.output.write('\n')
        
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
        
    return 0

if __name__ == '__main__':
    raise SystemExit(main())