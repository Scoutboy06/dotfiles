#!/usr/bin/env bash

# 1. Check if PROJECTS_DIR is set; fallback to ~/Projects if not
TARGET_DIR="${PROJECTS_DIR:-$HOME/p}"

if [ ! -d "$TARGET_DIR" ]; then
    notify-send "Project Launcher" "Directory $TARGET_DIR does not exist." -u critical
    exit 1
fi

# 2. Get a list of all directories inside your projects folder
# We use 'find' to get top-level folders only, and 'basename' to clean up the paths
CHOICE=$(find "$TARGET_DIR" -maxdepth 1 -mindepth 1 -type d -exec basename {} \; | sort | walker --dmenu --placeholder="󱔗 Projects: ")

# 3. If the user cancelled the menu, exit gracefully
if [ -z "$CHOICE" ]; then
    exit 0
fi

# 4. Define the full path to the selected project
PROJECT_PATH="$TARGET_DIR/$CHOICE"

# 5. Open the project in the default editor
omarchy-launch-editor "$PROJECT_PATH"
