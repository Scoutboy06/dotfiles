#!/usr/bin/env python3
"""Disk usage notifier for Omarchy/Hyprland.

Designed to be run from a systemd --user timer. Uses `df` to read disk usage
for a mountpoint and `notify-send` to send desktop notifications.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path


MOUNTPOINT = "/"

# Thresholds (percent full) for MOUNTPOINT.
WARN_PCT = 95
CRIT_PCT = 98

# If > 0, re-notify while still CRIT after this many seconds.
RENOTIFY_CRIT_SECONDS = 6 * 60 * 60


def cache_dir() -> Path:
    xdg = os.environ.get("XDG_CACHE_HOME")
    if xdg:
        return Path(xdg)
    return Path.home() / ".cache"


STATE_FILE = cache_dir() / "disk-usage-watch.state"


@dataclass
class State:
    last_level: str = ""
    last_crit_ts: int = 0


def now_epoch() -> int:
    return int(time.time())


def read_state(path: Path) -> State:
    if not path.exists():
        return State()

    try:
        raw = path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return State()

    if not raw:
        return State()

    # New format: JSON.
    if raw.startswith("{"):
        try:
            obj = json.loads(raw)
            return State(
                last_level=str(obj.get("last_level", "")),
                last_crit_ts=int(obj.get("last_crit_ts", 0) or 0),
            )
        except (ValueError, TypeError):
            return State()

    # Back-compat: shell-style state file.
    # Example:
    #   last_level="WARN"
    #   last_crit_ts=1700000000
    level = ""
    crit_ts = 0
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r"^last_level=(?:\"(?P<v>[^\"]*)\"|(?P<v2>\S+))$", line)
        if m:
            level = (m.group("v") or m.group("v2") or "").strip()
            continue
        m = re.match(r"^last_crit_ts=(?P<v>\d+)$", line)
        if m:
            try:
                crit_ts = int(m.group("v"))
            except ValueError:
                crit_ts = 0

    return State(last_level=level, last_crit_ts=crit_ts)


def write_state(path: Path, state: State) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps(
                {"last_level": state.last_level, "last_crit_ts": state.last_crit_ts},
                sort_keys=True,
            )
            + "\n",
            encoding="utf-8",
        )
    except OSError:
        # Best-effort; do not fail the unit just because we can't write state.
        return


def disk_used_pct(mountpoint: str) -> int:
    df = shutil.which("df")
    if df is None:
        raise RuntimeError("missing command: df")

    # Arch's df supports --output.
    cp = subprocess.run(
        [df, "--output=pcent", "--", mountpoint],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if cp.returncode != 0:
        msg = (cp.stderr or "").strip() or f"df exited with {cp.returncode}"
        raise RuntimeError(msg)

    lines = [ln.strip() for ln in (cp.stdout or "").splitlines() if ln.strip()]
    if len(lines) < 2:
        raise RuntimeError(f"unexpected df output: {cp.stdout!r}")

    # First line is header (Use%). Second line is like: 92%
    pct_raw = lines[1]
    pct_raw = pct_raw.rstrip("%")
    if not pct_raw.isdigit():
        raise RuntimeError(f"failed to parse df output: {pct_raw!r}")
    return int(pct_raw)


def level_for_pct(pct: int) -> str:
    if pct >= CRIT_PCT:
        return "CRIT"
    if pct >= WARN_PCT:
        return "WARN"
    return "OK"


def notify(urgency: str, title: str, body: str) -> None:
    notify_send = shutil.which("notify-send")
    if notify_send is None:
        return
    subprocess.run(
        [notify_send, "-u", urgency, title, body],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main(argv: list[str]) -> int:
    if argv:
        # Keep this as a simple utility; no CLI yet.
        print("error: no arguments supported", file=sys.stderr)
        return 2

    used_pct = disk_used_pct(MOUNTPOINT)
    level = level_for_pct(used_pct)

    state = read_state(STATE_FILE)
    ts = now_epoch()

    should_notify = False
    if level == "WARN" and state.last_level not in ("WARN", "CRIT"):
        should_notify = True

    if level == "CRIT" and state.last_level != "CRIT":
        should_notify = True
        state.last_crit_ts = ts

    if (
        level == "CRIT"
        and state.last_level == "CRIT"
        and RENOTIFY_CRIT_SECONDS > 0
        and (ts - state.last_crit_ts) >= RENOTIFY_CRIT_SECONDS
    ):
        should_notify = True
        state.last_crit_ts = ts

    if should_notify and level == "WARN":
        notify(
            "normal",
            "Disk space getting full",
            f"{MOUNTPOINT} is {used_pct}% full",
        )
    elif should_notify and level == "CRIT":
        notify(
            "critical",
            "Disk space critically full",
            f"{MOUNTPOINT} is {used_pct}% full (crit at {CRIT_PCT}%).",
        )

    state.last_level = level
    write_state(STATE_FILE, state)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
