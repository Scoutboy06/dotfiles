#!/bin/bash

set -euo pipefail

PRIMARY_MONITOR="DP-1"
SECONDARY_MONITOR="HDMI-A-1"
SERIES_WORKSPACE="name:series"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr"
MODE_FILE="$STATE_DIR/series-workspaces.lua"
PREVIOUS_SECONDARY_FILE="$STATE_DIR/series-previous-secondary"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/hypr-workspace-mode.lock"

usage() {
  echo "Usage: hypr-workspace-mode <toggle|series|normal|status> [--no-capture]" >&2
}

notify() {
  local headline=$1
  local description=${2:-}

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -u low "$headline" "$description"
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -u low "$headline" "$description"
  fi
}

fail() {
  notify "Workspace mode failed" "$1"
  echo "hypr-workspace-mode: $1" >&2
  exit 1
}

dispatch() {
  hyprctl dispatch "$1" >/dev/null
}

monitor_exists() {
  local monitor=$1
  hyprctl -j monitors | jq -e --arg monitor "$monitor" '.[] | select(.name == $monitor)' >/dev/null
}

active_workspace_on() {
  local monitor=$1
  hyprctl -j monitors | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .activeWorkspace.name'
}

normal_workspace_or() {
  local workspace=$1
  local fallback=$2

  if [[ $workspace =~ ^([1-9]|10)$ ]]; then
    printf '%s\n' "$workspace"
  else
    printf '%s\n' "$fallback"
  fi
}

reload_config() {
  local output errors

  if ! output=$(hyprctl reload config-only 2>&1); then
    echo "$output" >&2
    return 1
  fi

  errors=$(hyprctl configerrors)
  if [[ -n ${errors//[[:space:]]/} ]]; then
    echo "$errors" >&2
    return 1
  fi
}

write_series_rules() {
  local temporary
  temporary=$(mktemp "$STATE_DIR/.series-workspaces.lua.XXXXXX")
  cat >"$temporary" <<'LUA'
-- Generated by hypr-workspace-mode. Remove via `hypr-workspace-mode normal`.
for workspace = 1, 10 do
  hl.workspace_rule({ workspace = tostring(workspace), monitor = "DP-1" })
end

hl.workspace_rule({
  workspace = "name:series",
  monitor = "HDMI-A-1",
  default = true,
  persistent = true,
})
LUA
  mv "$temporary" "$MODE_FILE"
}

move_numeric_workspaces_to_primary() {
  local workspace

  while read -r workspace; do
    [[ -n $workspace ]] || continue
    dispatch "hl.dsp.workspace.move({ workspace = \"$workspace\", monitor = \"$PRIMARY_MONITOR\" })"
  done < <(hyprctl -j workspaces | jq -r '.[] | select(.id >= 1 and .id <= 10) | .id' | sort -n)
}

restore_numeric_workspace_split() {
  local workspace monitor

  while read -r workspace; do
    [[ -n $workspace ]] || continue
    if ((workspace % 2 == 1)); then
      monitor=$PRIMARY_MONITOR
    else
      monitor=$SECONDARY_MONITOR
    fi
    dispatch "hl.dsp.workspace.move({ workspace = \"$workspace\", monitor = \"$monitor\" })"
  done < <(hyprctl -j workspaces | jq -r '.[] | select(.id >= 1 and .id <= 10) | .id' | sort -n)
}

series_candidate() {
  local secondary_id active
  secondary_id=$(hyprctl -j monitors | jq -r --arg monitor "$SECONDARY_MONITOR" '.[] | select(.name == $monitor) | .id')

  # Let the user choose by focusing a window on the secondary monitor before
  # toggling. If focus is elsewhere, fall back to a visible fullscreen window
  # or the sole visible window on that monitor.
  active=$(hyprctl -j activewindow | jq -r --argjson monitor "$secondary_id" '
    select(.mapped == true and .monitor == $monitor) | .address // empty
  ')
  if [[ -n $active ]]; then
    printf '%s\n' "$active"
    return
  fi

  hyprctl -j clients | jq -r --argjson monitor "$secondary_id" '
    [.[] | select(.monitor == $monitor and .visible == true)] as $visible
    | (($visible | map(select(.fullscreen > 0)) | first)
       // (if ($visible | length) == 1 then $visible[0] else empty end))
    | .address // empty
  '
}

enter_series_mode() {
  local capture=$1
  local primary_workspace secondary_workspace candidate=""

  if [[ -f $MODE_FILE ]]; then
    notify "Series mode" "Already active"
    return
  fi

  primary_workspace=$(normal_workspace_or "$(active_workspace_on "$PRIMARY_MONITOR")" 1)
  secondary_workspace=$(normal_workspace_or "$(active_workspace_on "$SECONDARY_MONITOR")" 2)
  printf '%s\n' "$secondary_workspace" >"$PREVIOUS_SECONDARY_FILE"

  if [[ $capture == true ]]; then
    candidate=$(series_candidate)
  fi

  write_series_rules
  if ! reload_config; then
    rm -f "$MODE_FILE"
    hyprctl reload config-only >/dev/null 2>&1 || true
    fail "Hyprland rejected the series workspace rules"
  fi

  if [[ -n $candidate ]]; then
    dispatch "hl.dsp.window.move({ workspace = \"$SERIES_WORKSPACE\", follow = false, window = \"address:$candidate\" })"
  fi

  # Make the series workspace the visible workspace on the secondary monitor,
  # then move every existing numbered workspace to the primary monitor.
  dispatch "hl.dsp.focus({ workspace = \"$SERIES_WORKSPACE\" })"
  move_numeric_workspaces_to_primary
  dispatch "hl.dsp.focus({ workspace = \"$primary_workspace\" })"

  notify "Series mode" "Workspaces 1–10 are on $PRIMARY_MONITOR"
}

enter_normal_mode() {
  local primary_workspace secondary_workspace backup

  if [[ ! -f $MODE_FILE ]]; then
    notify "Normal mode" "Already active"
    return
  fi

  primary_workspace=$(normal_workspace_or "$(active_workspace_on "$PRIMARY_MONITOR")" 1)
  secondary_workspace=2
  if [[ -f $PREVIOUS_SECONDARY_FILE ]]; then
    secondary_workspace=$(normal_workspace_or "$(<"$PREVIOUS_SECONDARY_FILE")" 2)
  fi

  backup="$MODE_FILE.rollback"
  mv "$MODE_FILE" "$backup"
  if ! reload_config; then
    mv "$backup" "$MODE_FILE"
    hyprctl reload config-only >/dev/null 2>&1 || true
    fail "Hyprland rejected the normal workspace rules"
  fi
  rm -f "$backup"

  restore_numeric_workspace_split
  dispatch "hl.dsp.focus({ workspace = \"$secondary_workspace\" })"
  dispatch "hl.dsp.focus({ workspace = \"$primary_workspace\" })"
  rm -f "$PREVIOUS_SECONDARY_FILE"

  notify "Normal mode" "Odd/even workspace split restored"
}

main() {
  local action=${1:-toggle}
  local capture=true

  if [[ ${2:-} == "--no-capture" ]]; then
    capture=false
  elif (($# > 1)); then
    usage
    exit 2
  fi

  command -v hyprctl >/dev/null 2>&1 || fail "hyprctl is unavailable"
  command -v jq >/dev/null 2>&1 || fail "jq is unavailable"

  mkdir -p "$STATE_DIR"
  exec 9>"$LOCK_FILE"
  flock -n 9 || fail "another mode switch is already running"

  if [[ $action == status ]]; then
    if [[ -f $MODE_FILE ]]; then
      echo series
    else
      echo normal
    fi
    return
  fi

  monitor_exists "$PRIMARY_MONITOR" || fail "$PRIMARY_MONITOR is not connected"
  monitor_exists "$SECONDARY_MONITOR" || fail "$SECONDARY_MONITOR is not connected"

  case $action in
  toggle)
    if [[ -f $MODE_FILE ]]; then
      enter_normal_mode
    else
      enter_series_mode "$capture"
    fi
    ;;
  series) enter_series_mode "$capture" ;;
  normal) enter_normal_mode ;;
  *)
    usage
    exit 2
    ;;
  esac
}

main "$@"
