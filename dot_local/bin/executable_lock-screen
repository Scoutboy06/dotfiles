#!/bin/bash
set -euo pipefail

# Locks the system using hyprlock.
# Also locks 1password if running, and sets keyboard layout to default.
# Adapted from Omarchy.

# Lock the screen
pidof hyprlock || hyprlock &

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1 || true

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi
