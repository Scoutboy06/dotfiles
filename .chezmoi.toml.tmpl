{{- $hostname := .chezmoi.hostname -}}
{{- $isDesktop := or (eq $hostname "EliasPC") (eq $hostname "eliaspc") -}}
{{- $isLaptop := or (eq $hostname "eliaslt") (eq $hostname "EliasLT") -}}
{{- $isOmarchy := lookPath "omarchy" | not | not -}}
{{- $isWSL := (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}

{{- $isWorkLaptop := eq (env "DOTFILES_DEVICE") "worklt" -}}
{{- $winUser := env "DOTFILES_WINUSER" -}}

{{/* On WSL, ask Windows about itself rather than recording machine names here.
     Interop is called by absolute path because the shell strips /mnt/* from
     PATH, and each command always exits 0: output aborts the whole template on
     a non-zero exit, so unreachable interop would fail chezmoi init outright
     instead of falling back to the environment overrides above. */}}
{{- if $isWSL -}}
{{-   if not $winUser -}}
{{-     $winUser = output "/bin/sh" "-c" "/mnt/c/Windows/System32/cmd.exe /c \"echo %USERNAME%\" 2>/dev/null || true" | trim -}}
{{-   end -}}
{{/*  A domain-joined host is a corporate machine: %USERDOMAIN% differs from
       %COMPUTERNAME% only when the account is not local to the machine. */}}
{{-   if not (env "DOTFILES_DEVICE") -}}
{{-     $isWorkLaptop = eq (output "/bin/sh" "-c" "o=$(/mnt/c/Windows/System32/cmd.exe /c 'echo %USERDOMAIN% %COMPUTERNAME%' 2>/dev/null | tr -d '\\r'); set -- $o; if [ -n \"$1\" ] && [ \"$1\" != \"$2\" ]; then echo domain; fi" | trim) "domain" -}}
{{-   end -}}
{{- end -}}

{{- $device := "unknown" -}}
{{- if $isDesktop }}
{{-   $device = "eliaspc" }}
{{- else if $isLaptop }}
{{-   $device = "eliaslt" }}
{{- else if $isWorkLaptop }}
{{-   $device = "worklt" }}
{{- end }}

{{- $hasDE := or (eq .chezmoi.os "windows") $isOmarchy (and (not $isWSL) (not (eq $device "server"))) -}}

sourceDir = "/home/elias/p/dotfiles"

[data]
  hostname = {{ $hostname | quote }}
  device = {{ $device | quote }}
  isDesktop = {{ $isDesktop }}
  isLaptop = {{ $isLaptop }}
  isWorkLaptop = {{ $isWorkLaptop }}
  isOmarchy = {{ $isOmarchy }}
  isWSL = {{ $isWSL }}
  winUser = {{ $winUser | quote }}
  hasDE = {{ $hasDE }}
{{- if $isDesktop }}
  monitorScale = 1.0
  primaryMonitor = "DP-1"
{{- else if $isLaptop }}
  monitorScale = 1.25
  primaryMonitor = "eDP-1"
{{- end }}
  editor = "zeditor"

[merge]
command = "bash"
args = [
  "-c",
  {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},
]
