#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: lock-unless-ssid [--iface IFACE] [--file PATH] [SSID...]

Locks the current session unless connected to a trusted SSID.

Trusted SSIDs come from positional arguments if provided; otherwise from
--file (default: ~/.config/trusted-ssids.txt).

Notes:
- SSIDs are matched exactly.
- SSID is read via: iw dev <iface> link
USAGE
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

default_iface() {
  local a b _
  while read -r a b _; do
    if [[ $a == "Interface" && -n $b ]]; then
      printf '%s\n' "$b"
      return 0
    fi
  done < <(iw dev 2>/dev/null || true)
  return 1
}

current_ssid() {
  local iface="$1"
  local line

  while IFS= read -r line; do
    if [[ $line == *$'\tSSID: '* ]]; then
      printf '%s\n' "${line##*$'\tSSID: '}"
      return 0
    fi
    if [[ $line == SSID:\ * ]]; then
      printf '%s\n' "${line#SSID: }"
      return 0
    fi
  done < <(iw dev "$iface" link 2>/dev/null || true)

  printf '%s\n' ""
}

read_allowlist_file() {
  local file="$1"
  [[ -r $file ]] || return 0

  local line
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    [[ $line == \#* ]] && continue
    printf '%s\n' "$line"
  done <"$file"
}

main() {
  local iface=""
  local file="$HOME/.config/trusted-ssids.txt"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        return 0
        ;;
      --iface)
        [[ $# -ge 2 ]] || die "--iface requires a value"
        iface="$2"
        shift 2
        ;;
      --file)
        [[ $# -ge 2 ]] || die "--file requires a value"
        file="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "Unknown option: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  if [[ -z $iface ]]; then
    iface="$(default_iface || true)"
  fi

  # No Wi-Fi interface => unsafe (lock).
  if [[ -z $iface ]]; then
    loginctl lock-session
    return 0
  fi

  local ssid
  ssid="$(current_ssid "$iface")"

  # Not connected to Wi-Fi => unsafe (lock).
  if [[ -z $ssid ]]; then
    loginctl lock-session
    return 0
  fi

  local allowlist=()
  if [[ $# -gt 0 ]]; then
    allowlist=("$@")
  else
    while IFS= read -r line; do
      allowlist+=("$line")
    done < <(read_allowlist_file "$file")
  fi

  local safe
  for safe in "${allowlist[@]}"; do
    if [[ $ssid == "$safe" ]]; then
      return 0
    fi
  done

  loginctl lock-session
}

main "$@"
