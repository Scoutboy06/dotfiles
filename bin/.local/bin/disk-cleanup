            estimate=estimate_delete_paths([Path.home() / ".cache/JetBrains"]),
        ),
        Patch(
            patch_id="pnpm-store-prune",
            title="Prune pnpm store",
            description="Runs: pnpm store prune",
            requires=("pnpm", "du"),
            run=patch_pnpm_store_prune,
            measure=measure_pnpm_store,
            estimate=estimate_pnpm_store,
        ),
        Patch(
            patch_id="npm-cache-clean",
            title="Clean npm cache",
