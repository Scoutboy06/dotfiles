    return [
        Patch(
            patch_id="pacman-contrib-install",
            title="Install pacman-contrib",
            description="Installs paccache tooling used by pacman cache patches.",
            requires=("sudo", "pacman"),
            run=patch_pacman_contrib_install,
            measure=None,
            estimate=lambda _ctx: Estimate(bytes=None, note="no savings"),
        ),
        Patch(
            patch_id="pacman-cache-keep-2",
            title="Prune pacman cache (keep 2)",
            description="Keeps only newest 2 cached versions per package.",
            requires=("sudo", "paccache", "du"),
            run=patch_paccache_keep2,
            measure=measure_pacman_cache,
            estimate=estimate_paccache_keep2,
        ),
        Patch(
            patch_id="pacman-cache-uninstalled",
            title="Prune pacman cache (uninstalled)",
            description="Removes cached packages that are not currently installed.",
            requires=("sudo", "paccache", "du"),
            run=patch_paccache_uninstalled,
            measure=measure_pacman_cache,
            estimate=estimate_paccache_uninstalled,
        ),
        Patch(
            patch_id="steam-caches",
            title="Delete Steam caches",
            description="Deletes shadercache/htmlcache/librarycache/depotcache/httpcache (keeps games + compatdata).",
            requires=("du",),
            run=patch_steam_caches,
            measure=measure_steam_caches,
            estimate=estimate_delete_paths(
                [
                    Path.home() / ".local/share/Steam/steamapps/shadercache",
                    Path.home() / ".local/share/Steam/appcache/httpcache",
                    Path.home() / ".local/share/Steam/appcache/librarycache",
                    Path.home() / ".local/share/Steam/config/htmlcache",
                    Path.home() / ".local/share/Steam/depotcache",
                ]
            ),
        ),
        Patch(
            patch_id="cache-spotify",
            title="Delete Spotify cache",
            description="Deletes ~/.cache/spotify (app cache; not Flatpak-specific).",
            requires=("du",),
            run=lambda ctx: patch_delete_home_path(ctx, Path.home() / ".cache/spotify"),
            measure=lambda ctx: measure_path(ctx, Path.home() / ".cache/spotify"),
            estimate=estimate_delete_paths([Path.home() / ".cache/spotify"]),
        ),
        Patch(
            patch_id="cache-brave",
            title="Delete Brave cache",
            description="Deletes ~/.cache/BraveSoftware (app cache; not Flatpak-specific).",
            requires=("du",),
            run=lambda ctx: patch_delete_home_path(ctx, Path.home() / ".cache/BraveSoftware"),
            measure=lambda ctx: measure_path(ctx, Path.home() / ".cache/BraveSoftware"),
            estimate=estimate_delete_paths([Path.home() / ".cache/BraveSoftware"]),
        ),
        Patch(
            patch_id="cache-jetbrains",
            title="Delete JetBrains cache",
            description="Deletes ~/.cache/JetBrains (app cache; not Flatpak-specific).",
            requires=("du",),
            run=lambda ctx: patch_delete_home_path(ctx, Path.home() / ".cache/JetBrains"),
