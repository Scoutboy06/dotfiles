def preflight(patches: list[Patch]) -> None:
    missing: list[str] = []
    for p in patches:
        for cmd in p.requires:
            if shutil.which(cmd) is None:
                missing.append(f"{p.patch_id}: missing command {cmd}")
    if missing:
        msg = "\n".join(missing)
        raise PatchError(f"preflight failed:\n{msg}")


def render_list_for_curses(
    patches: list[Patch], selected: set[int], estimates: dict[str, Estimate]
) -> list[str]:
    lines: list[str] = []
    for i, p in enumerate(patches):
        mark = "x" if i in selected else " "
        sudo = " (sudo)" if "sudo" in p.requires else ""
        tail = ""
        est = estimates.get(p.patch_id)
        if est is not None and est.bytes is not None:
            tail = f"  ~{fmt_bytes(est.bytes)}"
        lines.append(f"[{mark}] {p.title}{sudo}{tail}")
    return lines


def curses_select(patches: list[Patch]) -> list[Patch]:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise PatchError("interactive mode requires a TTY (use --only or --no-ui)")

    def _inner(stdscr: "curses._CursesWindow") -> list[Patch]:
        curses.curs_set(0)
        stdscr.nodelay(False)
        stdscr.keypad(True)

        idx = 0
        selected: set[int] = set()
        top = 0
        estimates: dict[str, Estimate] = {}
        status = ""

        ctx = Context(dry_run=True, yes=True, report_path=Path("/dev/null"), sudo_estimates=False)

        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()

            title = "Disk cleanup"
            help1 = "Up/Down (or j/k), Space=toggle, e=estimate, s=sudo est., Enter=run, q=quit"
            stdscr.addnstr(0, 0, title, w - 1)
            stdscr.addnstr(1, 0, help1, w - 1)

            lines = render_list_for_curses(patches, selected, estimates)
            max_lines = max(1, h - 6)
            if idx >= top + max_lines:
                top = idx - max_lines + 1
            if idx < top:
                top = idx

            for row, line in enumerate(lines[top : top + max_lines], start=3):
                i = top + (row - 3)
                if i == idx:
                    stdscr.attron(curses.A_REVERSE)
                    stdscr.addnstr(row, 0, line, w - 1)
                    stdscr.attroff(curses.A_REVERSE)
                else:
                    stdscr.addnstr(row, 0, line, w - 1)

            footer = status or f"Selected: {len(selected)} | sudo estimates: {'on' if ctx.sudo_estimates else 'off'}"
            stdscr.addnstr(h - 3, 0, footer, w - 1)

            desc = patches[idx].description if patches else ""
            stdscr.addnstr(h - 2, 0, desc, w - 1)

            est = None
            if patches:
                est = estimates.get(patches[idx].patch_id)
            est_line = "Est. savings: "
            if est is None:
                est_line += "(press 'e')"
            else:
                est_line += fmt_estimate(est)
            stdscr.addnstr(h - 1, 0, est_line, w - 1)
            stdscr.refresh()

            ch = stdscr.getch()
            if ch in (ord("q"), 27):
                raise PatchError("aborted")
            if ch in (curses.KEY_DOWN, ord("j")):
                idx = min(len(patches) - 1, idx + 1)
            elif ch in (curses.KEY_UP, ord("k")):
                idx = max(0, idx - 1)
            elif ch == ord(" "):
                if idx in selected:
                    selected.remove(idx)
                else:
                    selected.add(idx)
            elif ch in (curses.KEY_ENTER, 10, 13):
                return [patches[i] for i in sorted(selected)]
            elif ch == ord("s"):
                status = "Validating sudo..."
                stdscr.addnstr(h - 3, 0, status, w - 1)
                stdscr.refresh()
                try:
                    sudo_validate()
                    ctx = Context(
                        dry_run=True,
                        yes=True,
                        report_path=ctx.report_path,
                        sudo_estimates=True,
                    )
                    status = "sudo estimates enabled"
                except Exception as e:  # noqa: BLE001
                    status = f"sudo failed: {e}"
            elif ch == ord("e"):
                if not patches:
                    continue
                p = patches[idx]
                if p.estimate is None:
                    estimates[p.patch_id] = Estimate(bytes=None, note="no estimate")
                    continue
                status = "Estimating..."
                stdscr.addnstr(h - 3, 0, status, w - 1)
                stdscr.refresh()
                try:
                    estimates[p.patch_id] = p.estimate(ctx)
                    status = ""
                except Exception as e:  # noqa: BLE001
                    estimates[p.patch_id] = Estimate(bytes=None, note=str(e))
                    status = ""
    
    return curses.wrapper(_inner)


def build_report_path() -> Path:
    ts = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    return cache_dir() / "disk-cleanup" / "runs" / f"{ts}.json"


def write_report(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def execute_selected(ctx: Context, selected: list[Patch]) -> int:
    preflight(selected)

    if not selected:
        print("No patches selected.")
        return 0

    if not ctx.yes and not ctx.dry_run:
        ids = ", ".join(p.patch_id for p in selected)
        ask_confirm(f"About to run: {ids}")

    runs: list[PatchRun] = []
    started = time.time()

    for p in selected:
        t0 = time.time()
        before = p.measure(ctx) if p.measure else None
        try:
            p.run(ctx)
            after = p.measure(ctx) if p.measure else None
            saved = None
            if before is not None and after is not None:
                saved = max(0, before - after)
            dt = time.time() - t0
            runs.append(
                PatchRun(
                    patch_id=p.patch_id,
                    title=p.title,
                    ok=True,
                    saved_bytes=saved,
                    before_bytes=before,
                    after_bytes=after,
                    duration_s=dt,
                    error=None,
                )
            )
            print(f"ok: {p.patch_id} ({p.title}) saved {fmt_bytes(saved)}")
        except Exception as e:  # noqa: BLE001
            dt = time.time() - t0
            runs.append(
                PatchRun(
                    patch_id=p.patch_id,
                    title=p.title,
                    ok=False,
                    saved_bytes=None,
                    before_bytes=before,
                    after_bytes=None,
                    duration_s=dt,
                    error=str(e),
                )
            )
            print(f"error: {p.patch_id} ({p.title})", file=sys.stderr)
            print(f"  {e}", file=sys.stderr)
            payload = {
                "dry_run": ctx.dry_run,
                "started_ts": started,
                "ended_ts": time.time(),
                "runs": [r.__dict__ for r in runs],
            }
            write_report(ctx.report_path, payload)
            print(f"wrote report: {ctx.report_path}")
            return 1

    payload = {
        "dry_run": ctx.dry_run,
        "started_ts": started,
        "ended_ts": time.time(),
        "runs": [r.__dict__ for r in runs],
    }
    write_report(ctx.report_path, payload)
    print(f"wrote report: {ctx.report_path}")
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="disk-cleanup")
    p.add_argument("--list", action="store_true", help="List available patches")
    p.add_argument(
        "--preview",
        action="store_true",
        help="Print estimated savings for each patch (no changes)",
    )
    p.add_argument("--dry-run", action="store_true", help="Show what would run")
    p.add_argument(
        "--only",
        action="append",
        default=[],
        metavar="PATCH_ID",
        help="Run only this patch (repeatable)",
    )
    p.add_argument("--yes", action="store_true", help="Skip confirmation prompt")
    p.add_argument(
        "--no-ui",
        action="store_true",
        help="Do not use curses UI (requires --only)",
    )
    p.add_argument(
        "--sudo-estimates",
        action="store_true",
        help="Allow estimates that require sudo (may prompt)",
    )
    return p.parse_args(argv)


def main(argv: list[str]) -> int:
    ns = parse_args(argv)
    patches = all_patches()
    patch_by_id = {p.patch_id: p for p in patches}

    if ns.list:
        for p in patches:
            print(f"{p.patch_id}\t{p.title}\t{p.description}")
        return 0

    if ns.preview:
        ctx = Context(
            dry_run=True,
            yes=True,
            report_path=build_report_path(),
            sudo_estimates=bool(ns.sudo_estimates),
        )
        if ctx.sudo_estimates:
            try:
                sudo_validate()
            except Exception as e:  # noqa: BLE001
                print(f"warning: sudo estimates disabled: {e}", file=sys.stderr)
                ctx = Context(
                    dry_run=True,
                    yes=True,
                    report_path=ctx.report_path,
                    sudo_estimates=False,
                )

        for p in patches:
            est: Estimate | None = None
            if p.estimate is not None:
                try:
                    est = p.estimate(ctx)
                except Exception as e:  # noqa: BLE001
                    est = Estimate(bytes=None, note=str(e))
            print(f"{p.title}\t{fmt_estimate(est)}")
        return 0

    report_path = build_report_path()
    ctx = Context(
        dry_run=bool(ns.dry_run),
        yes=bool(ns.yes),
        report_path=report_path,
        sudo_estimates=bool(ns.sudo_estimates),
    )

    selected: list[Patch]
    if ns.only:
        unknown = [x for x in ns.only if x not in patch_by_id]
        if unknown:
            print("error: unknown patch id(s): " + ", ".join(unknown), file=sys.stderr)
            return 2
        selected = [patch_by_id[x] for x in ns.only]
    else:
        if ns.no_ui:
            print("error: --no-ui requires --only", file=sys.stderr)
            return 2
        selected = curses_select(patches)

    try:
        return execute_selected(ctx, selected)
    except PatchError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
