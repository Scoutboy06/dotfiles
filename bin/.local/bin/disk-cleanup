#!/usr/bin/env python3
"""Interactive disk cleanup runner.

This turns a set of common cleanup commands (caches, logs, package archives)
into a reusable, selectable, fail-fast script.
"""

from __future__ import annotations

import argparse
import curses
import datetime as _dt
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Callable, Iterable


MiB = 1024 * 1024


def cache_dir() -> Path:
    xdg = os.environ.get("XDG_CACHE_HOME")
    if xdg:
        return Path(xdg)
    return Path.home() / ".cache"


def fmt_bytes(n: int | None) -> str:
    if n is None:
        return "n/a"
    if n < 0:
        n = 0
    units = ["B", "KiB", "MiB", "GiB", "TiB"]
    v = float(n)
    u = 0
    while v >= 1024.0 and u < len(units) - 1:
        v /= 1024.0
        u += 1
    if u == 0:
        return f"{int(v)}{units[u]}"
    return f"{v:.1f}{units[u]}"


@dataclass(frozen=True)
class Estimate:
    bytes: int | None
    note: str = ""


def fmt_estimate(est: Estimate | None) -> str:
    if est is None or est.bytes is None:
        if est is None or not est.note:
            return "n/a"
        return f"n/a ({est.note})"
    if est.note:
        return f"{fmt_bytes(est.bytes)} ({est.note})"
    return fmt_bytes(est.bytes)


class PatchError(RuntimeError):
    pass


@dataclass(frozen=True)
class Patch:
    patch_id: str
    title: str
    description: str
    requires: tuple[str, ...]
    run: Callable[["Context"], None]
    measure: Callable[["Context"], int | None] | None = None
    estimate: Callable[["Context"], Estimate] | None = None


@dataclass(frozen=True)
class PatchRun:
    patch_id: str
    title: str
    ok: bool
    saved_bytes: int | None
    before_bytes: int | None
    after_bytes: int | None
    duration_s: float
    error: str | None


@dataclass(frozen=True)
class Context:
    dry_run: bool
    yes: bool
    report_path: Path
    sudo_estimates: bool = False


def run_cmd(argv: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    cp = subprocess.run(
        argv,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and cp.returncode != 0:
        stderr = (cp.stderr or "").strip()
        stdout = (cp.stdout or "").strip()
        msg = stderr or stdout or f"command exited with {cp.returncode}"
        raise PatchError(f"{argv!r} failed: {msg}")
    return cp


def du_bytes(paths: Iterable[Path], *, sudo: bool = False) -> int:
    du = shutil.which("du")
    if du is None:
        raise PatchError("missing command: du")

    existing: list[Path] = [p for p in paths if p.exists()]
    if not existing:
        return 0

    argv: list[str] = [du, "-sb", "--"] + [str(p) for p in existing]
    if sudo:
        argv = ["sudo", "--"] + argv
    cp = run_cmd(argv)

    total = 0
    for line in (cp.stdout or "").splitlines():
        line = line.strip()
        if not line:
            continue
        # Format: <bytes>\t<path>
        first = line.split(None, 1)[0]
        try:
            total += int(first)
        except ValueError:
            raise PatchError(f"failed to parse du output line: {line!r}")
    return total


def parse_size_to_bytes(s: str) -> int:
    s = s.strip()
    if not s:
        raise PatchError("empty size")
    num = ""
    unit = ""
    for ch in s:
        if ch.isdigit() or ch == ".":
            num += ch
        elif ch.isspace():
            continue
        else:
            unit += ch
    if not num:
        raise PatchError(f"failed to parse size: {s!r}")
    try:
        v = float(num)
    except ValueError as e:
        raise PatchError(f"failed to parse size number: {s!r}") from e

    unit = unit.strip()
    mult = {
        "B": 1,
        "K": 1024,
        "KB": 1024,
        "KI": 1024,
        "KIB": 1024,
        "M": 1024**2,
        "MB": 1024**2,
        "MI": 1024**2,
        "MIB": 1024**2,
        "G": 1024**3,
        "GB": 1024**3,
        "GI": 1024**3,
        "GIB": 1024**3,
        "T": 1024**4,
        "TB": 1024**4,
        "TI": 1024**4,
        "TIB": 1024**4,
    }
    key = unit.upper()
    if key == "":
        # journalctl output usually includes a unit; but accept raw bytes.
        return int(v)
    if key not in mult:
        raise PatchError(f"unknown size unit: {unit!r}")
    return int(v * mult[key])


def journalctl_disk_usage_bytes() -> int:
    cp = run_cmd(["sudo", "--", "journalctl", "--disk-usage"])
    out = (cp.stdout or "").strip()
    # Example:
    #   Archived and active journals take up 800.0M in the file system.
    # We parse the first token that looks like a number+unit.
    tokens = out.replace(".", ".").split()
    for tok in tokens:
        # Heuristic: token contains a digit, and ends in a letter.
        if any(c.isdigit() for c in tok) and any(c.isalpha() for c in tok):
            # Strip trailing punctuation.
            tok = tok.rstrip(".\n\r\t,;:")
            try:
                return parse_size_to_bytes(tok)
            except PatchError:
                continue
    raise PatchError(f"failed to parse journalctl --disk-usage output: {out!r}")


def require_cmd(name: str) -> None:
    if shutil.which(name) is None:
        raise PatchError(f"missing command: {name}")


def sudo_validate() -> None:
    require_cmd("sudo")
    run_cmd(["sudo", "-v"])


def safe_rmtree(path: Path) -> None:
    if not path.exists():
        return
    home = Path.home().resolve()
    try:
        rp = path.expanduser().resolve()
    except FileNotFoundError:
        # Broken symlink etc.
        rp = path.expanduser().absolute()
    if home not in rp.parents and rp != home:
        raise PatchError(f"refusing to delete outside $HOME: {path}")
    if rp == home:
        raise PatchError("refusing to delete $HOME")
    shutil.rmtree(rp)


def ask_confirm(prompt: str) -> None:
    print(prompt)
    print("Type 'yes' to continue: ", end="", flush=True)
    ans = sys.stdin.readline().strip().lower()
    if ans != "yes":
        raise PatchError("aborted")


def patch_pacman_contrib_install(ctx: Context) -> None:
    require_cmd("sudo")
    require_cmd("pacman")
    if ctx.dry_run:
        return
    run_cmd(["sudo", "--", "pacman", "-S", "--needed", "pacman-contrib"])


def patch_paccache_keep2(ctx: Context) -> None:
    require_cmd("sudo")
    require_cmd("paccache")
    if ctx.dry_run:
        return
    run_cmd(["sudo", "--", "paccache", "-rk2"])


def patch_paccache_uninstalled(ctx: Context) -> None:
    require_cmd("sudo")
    require_cmd("paccache")
    if ctx.dry_run:
        return
    run_cmd(["sudo", "--", "paccache", "-ruk0"])


def patch_steam_caches(ctx: Context) -> None:
    base = Path.home() / ".local/share/Steam"
    targets = [
        base / "steamapps/shadercache",
        base / "appcache/httpcache",
        base / "appcache/librarycache",
        base / "config/htmlcache",
        base / "depotcache",
    ]
    if ctx.dry_run:
        return
    for p in targets:
        safe_rmtree(p)


def patch_app_caches(ctx: Context) -> None:
    raise PatchError("internal error: patch_app_caches is removed")


def pnpm_store_path() -> Path | None:
    if shutil.which("pnpm") is None:
        return None
    cp = run_cmd(["pnpm", "store", "path"], check=False)
    if cp.returncode != 0:
        return None
    p = (cp.stdout or "").strip().splitlines()[0].strip()
    if not p:
        return None
    return Path(p).expanduser()


def npm_cache_path() -> Path | None:
    if shutil.which("npm") is None:
        return None
    cp = run_cmd(["npm", "config", "get", "cache"], check=False)
    if cp.returncode != 0:
        return None
    p = (cp.stdout or "").strip().splitlines()[0].strip()
    if not p:
        return None
    return Path(p).expanduser()


def measure_pnpm_store(_: Context) -> int | None:
    p = pnpm_store_path()
    if p is None:
        return None
    return du_bytes([p])


def measure_npm_cache(_: Context) -> int | None:
    p = npm_cache_path()
    if p is None:
        return None
    return du_bytes([p])


def patch_pnpm_store_prune(ctx: Context) -> None:
    require_cmd("pnpm")
    if ctx.dry_run:
        return
    run_cmd(["pnpm", "store", "prune"])


def patch_npm_cache_verify(ctx: Context) -> None:
    raise PatchError("internal error: npm-cache-verify patch removed")


def patch_npm_cache_clean(ctx: Context) -> None:
    require_cmd("npm")
    if ctx.dry_run:
        return
    run_cmd(["npm", "cache", "clean", "--force"])


def measure_pacman_cache(_: Context) -> int | None:
    # Use sudo in case /var/cache/pacman/pkg is not readable.
    return du_bytes([Path("/var/cache/pacman/pkg")], sudo=True)


def measure_steam_caches(_: Context) -> int | None:
    base = Path.home() / ".local/share/Steam"
    paths = [
        base / "steamapps/shadercache",
        base / "appcache/httpcache",
        base / "appcache/librarycache",
        base / "config/htmlcache",
        base / "depotcache",
    ]
    return du_bytes(paths)


def measure_app_caches(_: Context) -> int | None:
    raise PatchError("internal error: measure_app_caches is removed")


def measure_path(_: Context, path: Path) -> int | None:
    return du_bytes([path])


def patch_delete_home_path(ctx: Context, path: Path) -> None:
    if ctx.dry_run:
        return
    safe_rmtree(path)


def estimate_delete_paths(paths: list[Path]) -> Callable[[Context], Estimate]:
    def _est(_: Context) -> Estimate:
        return Estimate(bytes=du_bytes(paths), note="exact")

    return _est


def estimate_pnpm_store(_: Context) -> Estimate:
    p = pnpm_store_path()
    if p is None:
        return Estimate(bytes=None, note="pnpm not installed")
    # Prune result varies; report an upper bound.
    return Estimate(bytes=du_bytes([p]), note="up to")


def estimate_npm_cache(_: Context) -> Estimate:
    p = npm_cache_path()
    if p is None:
        return Estimate(bytes=None, note="npm not installed")
    return Estimate(bytes=du_bytes([p]), note="likely")


_PACCACHE_CANDIDATE_RE = re.compile(r"(?P<path>/(?:[^\s\x00]+))")


@dataclass(frozen=True)
class PaccacheDryRun:
    bytes: int
    parsed_paths: int
    no_candidates: bool


def paccache_dryrun_candidate_bytes(*, keep: int, uninstalled: bool) -> PaccacheDryRun:
    sudo_validate()
    require_cmd("paccache")
    argv = [
        "sudo",
        "--",
        "paccache",
        "-d",
        "--nocolor",
        "-vv",
        "-z",
        f"-k{keep}",
    ]
    if uninstalled:
        argv.append("-u")
    cp = run_cmd(argv)
    text = (cp.stdout or "") + "\n" + (cp.stderr or "")
    no_cand = "no candidate packages found" in text.lower()
    paths: set[Path] = set()
    for m in _PACCACHE_CANDIDATE_RE.finditer(text):
        p = m.group("path").rstrip(",;:)")
        if ".pkg.tar" not in p and not p.endswith(".sig"):
            continue
        paths.add(Path(p))
    total = 0
    for p in paths:
        try:
            total += p.stat().st_size
        except OSError:
            continue
    return PaccacheDryRun(bytes=total, parsed_paths=len(paths), no_candidates=no_cand)


def estimate_paccache_keep2(ctx: Context) -> Estimate:
    if not ctx.sudo_estimates:
        return Estimate(bytes=None, note="enable sudo estimates")
    dr = paccache_dryrun_candidate_bytes(keep=2, uninstalled=False)
    if dr.no_candidates:
        return Estimate(bytes=0, note="dry-run")
    if dr.parsed_paths == 0:
        return Estimate(bytes=None, note="dry-run (unparsed output)")
    return Estimate(bytes=dr.bytes, note="dry-run")


def estimate_paccache_uninstalled(ctx: Context) -> Estimate:
    if not ctx.sudo_estimates:
        return Estimate(bytes=None, note="enable sudo estimates")
    dr = paccache_dryrun_candidate_bytes(keep=0, uninstalled=True)
    if dr.no_candidates:
        return Estimate(bytes=0, note="dry-run")
    if dr.parsed_paths == 0:
        return Estimate(bytes=None, note="dry-run (unparsed output)")
    return Estimate(bytes=dr.bytes, note="dry-run")


def estimate_journal_vacuum_200m(ctx: Context) -> Estimate:
    if not ctx.sudo_estimates:
        return Estimate(bytes=None, note="enable sudo estimates")
    sudo_validate()
    cur = journalctl_disk_usage_bytes()
    target = 200 * MiB
    return Estimate(bytes=max(0, cur - target), note="upper bound")


def measure_journal(_: Context) -> int | None:
    return journalctl_disk_usage_bytes()


def patch_journal_vacuum(ctx: Context) -> None:
    require_cmd("sudo")
    require_cmd("journalctl")
    if ctx.dry_run:
        return
    run_cmd(["sudo", "--", "journalctl", "--vacuum-size=200M"])


