#!/usr/bin/env bash

# Launch a floating terminal, execute the command passed in, and finally end with the omarchy-show-done presentation.
# Clone of Omarchy's command with the logo removed.

cmd="$*"
exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title=Omarchy -e bash -c "$cmd; if (( \$? != 130 )); then omarchy-show-done; fi"
