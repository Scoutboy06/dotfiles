#!/usr/bin/env bash
# packages-appimage.yaml: {{ include ".packages/packages-appimage.yaml" | sha256sum }}
set -euo pipefail

log_info() { printf '\033[0;32m[INFO]\033[0m %s\n' "$*"; }
log_success() { printf '\033[0;34m[✓]\033[0m %s\n' "$*"; }
log_warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }
log_error() { printf '\033[0;31m[ERROR]\033[0m %s\n' "$*" >&2; }
if [[ $EUID -eq 0 ]]; then
    log_error "Do not run this script as root"
    exit 1
fi

{{ if eq .chezmoi.os "linux" }}
case "$(uname -m)" in
    x86_64) architecture=x86_64 ;;
    aarch64|arm64) architecture=aarch64 ;;
    *) log_warn "Unsupported AppImage architecture"; exit 0 ;;
esac

temporary_directory=''
trap '[[ -z "$temporary_directory" ]] || rm -rf -- "$temporary_directory"' EXIT

install_appimage() {
    local name="$1" version="$2" repository="$3" asset="$4" digest="$5" title="$6" categories="$7"
    local directory="$HOME/.local/share/appimages/$name"
    local executable="$directory/$name.AppImage"
    local command_path="$HOME/.local/bin/$name"
    [[ "$name" =~ ^[a-zA-Z0-9_-]+$ && "$digest" =~ ^[a-f0-9]{64}$ ]] || {
        log_error "Invalid AppImage name or SHA-256: $name"; return 1;
    }
    if [[ -e "$command_path" && ! -L "$command_path" ]]; then
        log_error "Refusing to overwrite existing command: $command_path"; return 1
    fi
    mkdir -p "$directory" "$HOME/.local/bin" "$HOME/.local/share/applications"
    if [[ ! -f "$executable" ]] || ! printf '%s  %s\n' "$digest" "$executable" | sha256sum --check --status; then
        log_info "Installing $name $version ($architecture)"
        temporary_directory=$(mktemp -d "$directory/.download.XXXXXX")
        curl --fail --location --retry 3 --proto '=https' --proto-redir '=https' \
            --output "$temporary_directory/app.AppImage" \
            "https://github.com/$repository/releases/download/$version/$asset"
        printf '%s  %s\n' "$digest" "$temporary_directory/app.AppImage" | sha256sum --check --status || {
            log_error "SHA-256 mismatch for $name; installed executable preserved"; return 1;
        }
        chmod 755 "$temporary_directory/app.AppImage"
        mv -f "$temporary_directory/app.AppImage" "$executable"
        rm -rf -- "$temporary_directory"
        temporary_directory=''
    fi
    chmod 755 "$executable"
    ln -sfn "$executable" "$command_path"
    # Use the desktop theme's generic development icon; no unverified icon download.
    cat > "$HOME/.local/share/applications/$name.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$title
Exec="$executable" %U
TryExec=$executable
Icon=applications-development
Terminal=false
Categories=$categories
EOF
    printf '%s\n' "$version" > "$directory/version"
    log_success "$name $version verified and installed"
}

{{ $device := .device }}
{{ $hasDE := .hasDE }}
{{ range $pkg := (include ".packages/packages-appimage.yaml" | fromYaml).packages }}
{{ if and (or (eq $pkg.device "all") (has $device (splitList "," $pkg.device))) (or (has "dev" (splitList "," $pkg.environment)) $hasDE) }}
case "$architecture" in
{{ range $arch, $asset := $pkg.assets }}
    {{ $arch }}) install_appimage {{ $pkg.name | quote }} {{ $pkg.version | quote }} {{ $pkg.github_repo | quote }} {{ $asset.filename | quote }} {{ $asset.sha256 | quote }} {{ $pkg.desktop.name | quote }} {{ $pkg.desktop.categories | quote }} ;;
{{ end }}
    *) log_warn "No $architecture asset configured for {{ $pkg.name }}; skipping" ;;
esac
{{ end }}
{{ end }}
{{ else }}
log_info "AppImages are only installed on Linux"
{{ end }}
