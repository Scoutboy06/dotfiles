#!/usr/bin/env bash

set -euo pipefail

{{ if not .isOmarchy -}}
exit 0
{{ else -}}
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_success() { echo -e "${BLUE}[✓]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

if [[ $EUID -eq 0 ]]; then
    log_error "Do not run this script as root"
    exit 1
fi

if ! command -v git &>/dev/null; then
    log_error "git is required to configure the credential helper"
    exit 1
fi

helper_path="$(git --exec-path)/git-credential-libsecret"
if [[ ! -x "$helper_path" ]]; then
    log_error "git-credential-libsecret is not installed"
    exit 1
fi

git_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/git"
local_config="$git_config_dir/config.local"
current_helpers="$(git config --file "$local_config" --get-all credential.helper 2>/dev/null || true)"

if [[ "$current_helpers" == "libsecret" ]]; then
    log_success "Git already uses the libsecret credential helper"
    exit 0
fi

log_info "Configuring Git to store credentials in the system keyring"
mkdir -p "$git_config_dir"
git config --file "$local_config" --replace-all credential.helper libsecret
log_success "Configured Git credential helper: libsecret"
{{- end }}
