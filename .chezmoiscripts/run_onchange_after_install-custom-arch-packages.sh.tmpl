#!/usr/bin/env bash
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
#
# Build and install Arch custom packages from remote git repos (makepkg/PKGBUILD)
# This script runs automatically when custom-arch-packages.yaml changes (run_onchange_)
# Non-Arch systems (no makepkg) are skipped cleanly.
#
# custom-arch-packages.yaml hash: # {{ include ".chezmoidata/custom-arch-packages.yaml" | sha256sum }}

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

BUILD_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-custom-packages"

# Check if running as root (we shouldn't be)
if [[ $EUID -eq 0 ]]; then
    log_error "Do not run this script as root"
    exit 1
fi

# These packages are built from Arch PKGBUILDs. Skip cleanly on non-Arch systems.
if ! command -v makepkg &>/dev/null; then
    log_warn "makepkg not found — skipping Arch custom packages (non-Arch system)"
    exit 0
fi

# Clone or update repo, then build and install
build_and_install() {
    local name="$1"
    local url="$2"
    local pkg_dir="$BUILD_DIR/$name"
    
    mkdir -p "$BUILD_DIR"
    
    if [[ -d "$pkg_dir" ]]; then
        log_info "Updating $name..."
        git -C "$pkg_dir" pull --ff-only
    else
        log_info "Cloning $name from $url..."
        git clone "$url" "$pkg_dir"
    fi
    
    if [[ ! -f "$pkg_dir/PKGBUILD" ]]; then
        log_error "No PKGBUILD found in $pkg_dir"
        return 1
    fi
    
    log_info "Building and installing $name..."
    
    pushd "$pkg_dir" > /dev/null
    makepkg -si --noconfirm --needed
    popd > /dev/null
    
    log_info "$name installed successfully!"
}

main() {
    log_info "Building custom packages from git repos..."

# {{- range .custom_packages }}
    build_and_install "# {{ .name }}" "# {{ .url }}"
# {{- end }}

    log_info "Custom package installation complete!"
}

main "$@"
