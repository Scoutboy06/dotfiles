#!/usr/bin/env bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
#
# Install packages from packages.yaml
# This script:
#   1. Filters out already-installed packages
#   2. Installs remaining packages from packages.yaml
#
# The script runs automatically when packages.yaml changes (run_onchange_ prefix).
#
# Hash (triggers re-execution if file changes):
# packages.yaml: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_success() { echo -e "${BLUE}[✓]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Check if running as root (we shouldn't be)
if [[ $EUID -eq 0 ]]; then
    log_error "Do not run this script as root"
    exit 1
fi

# Get list of already-installed packages
get_installed_packages() {
    pacman -Q --quiet 2>/dev/null || true
}

# Detect AUR helper
detect_aur_helper() {
    for helper in paru yay; do
        if command -v "$helper" &>/dev/null; then
            echo "$helper"
            return 0
        fi
    done
    return 1
}

# Install packages with pacman
install_pacman() {
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        return 0
    fi
    log_info "Installing ${#packages[@]} packages with pacman..."
    sudo pacman -S --needed --noconfirm "${packages[@]}"
}

# Install packages with AUR helper
install_aur() {
    local helper="$1"
    shift
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        return 0
    fi
    log_info "Installing ${#packages[@]} AUR packages with $helper..."
    "$helper" -S --needed --noconfirm "${packages[@]}"
}



install_packages_main() {
    log_info "Installing packages from packages.yaml..."

    # Get list of already-installed packages once
    local installed_packages
    installed_packages=$(get_installed_packages)

    # --- DYNAMIC PACKAGE ARRAY SELECTION FOR ANNOTATED LIST FORMAT ---
    # Determine device and os for filtering (device: 'all'|'desktop'|'laptop', os: 'all'|'omarchy').
    local device="all"
    local distro="all"
{{ if .isDesktop }}
    device="desktop"
{{ else if .isLaptop }}
    device="laptop"
{{ end }}
{{ if .isOmarchy }}
    distro="omarchy"
{{ end }}

    # Populate arrays: pacman_packages and aur_packages.
{{ $pkgs := (include ".chezmoidata/packages.yaml" | fromYaml).packages }}
    local pacman_packages=()
    local aur_packages=()
{{ range $pkg := $pkgs }}
{{ $matchesDevice := or (eq $pkg.device "all") (and (eq $pkg.device "desktop") $.isDesktop) (and (eq $pkg.device "laptop") $.isLaptop) }}
{{ $matchesOS := or (eq $pkg.os "all") (and (eq $pkg.os "omarchy") $.isOmarchy) }}
{{ if and (eq $pkg.source "pacman") $matchesDevice $matchesOS }}
    # Only add if not already installed
    if ! grep -q "^{{ $pkg.name }}$" <(echo "$installed_packages"); then
        pacman_packages+=("{{ $pkg.name }}")
    fi
{{ end }}
{{ if and (eq $pkg.source "aur") $matchesDevice $matchesOS }}
    # Only add if not already installed
    if ! grep -q "^{{ $pkg.name }}$" <(echo "$installed_packages"); then
        aur_packages+=("{{ $pkg.name }}")
    fi
{{ end }}
{{ end }}

    # Install pacman packages
    if [[ ${#pacman_packages[@]} -gt 0 ]]; then
        install_pacman "${pacman_packages[@]}"
    else
        log_info "No new pacman packages to install"
    fi

    # Install AUR packages
    if [[ ${#aur_packages[@]} -gt 0 ]]; then
        if aur_helper=$(detect_aur_helper); then
            install_aur "$aur_helper" "${aur_packages[@]}"
        else
            log_warn "No AUR helper found (paru/yay). Skipping AUR packages."
            log_warn "Install paru or yay and run 'chezmoi apply' again."
        fi
    else
        log_info "No new AUR packages to install"
    fi

    log_info "Package installation complete!"
}

main() {
    install_packages_main
    log_success "Package installation completed!"
}

main "$@"