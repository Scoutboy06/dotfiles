#!/usr/bin/env bash
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
#
# Install packages from packages.yaml
# This script runs automatically when packages.yaml changes (run_onchange_)
#
# packages.yaml hash: # {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Check if running as root (we shouldn't be)
if [[ $EUID -eq 0 ]]; then
    log_error "Do not run this script as root"
    exit 1
fi

# Detect AUR helper
detect_aur_helper() {
    for helper in paru yay; do
        if command -v "$helper" &>/dev/null; then
            echo "$helper"
            return 0
        fi
    done
    return 1
}

# Install packages with pacman
install_pacman() {
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        return 0
    fi
    log_info "Installing ${#packages[@]} packages with pacman..."
    sudo pacman -S --needed --noconfirm "${packages[@]}"
}

# Install packages with AUR helper
install_aur() {
    local helper="$1"
    shift
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        return 0
    fi
    log_info "Installing ${#packages[@]} AUR packages with $helper..."
    "$helper" -S --needed --noconfirm "${packages[@]}"
}

main() {
    log_info "Installing packages from packages.yaml..."

    # Common packages (pacman)
    local common_packages=(
# {{- range .common }}
        "# {{ . }}"
# {{- end }}
    )

    # AUR packages
    local aur_packages=(
# {{- range .aur }}
        "# {{ . }}"
# {{- end }}
    )

# {{- if .isDesktop }}
    # Desktop-specific packages
    local machine_packages=(
# {{- range .desktop }}
        "# {{ . }}"
# {{- end }}
    )
# {{- else if .isLaptop }}
    # Laptop-specific packages
    local machine_packages=(
# {{- range .laptop }}
        "# {{ . }}"
# {{- end }}
    )
# {{- else }}
    local machine_packages=()
# {{- end }}

    # Install common packages
    if [[ ${#common_packages[@]} -gt 0 ]]; then
        install_pacman "${common_packages[@]}"
    fi

    # Install machine-specific packages
    if [[ ${#machine_packages[@]} -gt 0 ]]; then
        install_pacman "${machine_packages[@]}"
    fi

    # Install AUR packages
    if [[ ${#aur_packages[@]} -gt 0 ]]; then
        if aur_helper=$(detect_aur_helper); then
            install_aur "$aur_helper" "${aur_packages[@]}"
        else
            log_warn "No AUR helper found (paru/yay). Skipping AUR packages."
            log_warn "Install paru or yay and run 'chezmoi apply' again."
        fi
    fi

    log_info "Package installation complete!"
}

main "$@"
