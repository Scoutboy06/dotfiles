#!/usr/bin/env bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
#
# Install packages and run post-install hooks
# This script:
#   1. Installs packages from packages.yaml
#   2. Runs post-installation hooks from post-install-hooks.yaml (in order)
#
# The script runs automatically when either packages.yaml or post-install-hooks.yaml
# changes (run_onchange_ prefix). This keeps package installation and post-install
# setup as a single declarative unit.
#
# Hashes (triggers re-execution if either file changes):
# packages.yaml: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# post-install-hooks.yaml: {{ include ".chezmoidata/post-install-hooks.yaml" | sha256sum }}

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_success() { echo -e "${BLUE}[✓]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Check if running as root (we shouldn't be)
if [[ $EUID -eq 0 ]]; then
    log_error "Do not run this script as root"
    exit 1
fi

# Detect AUR helper
detect_aur_helper() {
    for helper in paru yay; do
        if command -v "$helper" &>/dev/null; then
            echo "$helper"
            return 0
        fi
    done
    return 1
}

# Install packages with pacman
install_pacman() {
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        return 0
    fi
    log_info "Installing ${#packages[@]} packages with pacman..."
    sudo pacman -S --needed --noconfirm "${packages[@]}"
}

# Install packages with AUR helper
install_aur() {
    local helper="$1"
    shift
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        return 0
    fi
    log_info "Installing ${#packages[@]} AUR packages with $helper..."
    "$helper" -S --needed --noconfirm "${packages[@]}"
}

# Execute post-install hooks from post-install-hooks.yaml
# Each hook can contain multiple commands that run sequentially.
# If a command fails, remaining commands in that hook continue.
# If a hook fails, remaining hooks still attempt to run.
run_post_install_hooks() {
    log_info "Running post-install hooks..."
    echo ""

    # Track results
    local hooks_succeeded=0
    local hooks_failed=0

{{ $hooks := (include ".chezmoidata/post-install-hooks.yaml" | fromYaml).post_install_hooks }}
{{ range $hook := $hooks }}
    # Hook: {{ $hook.package }} - {{ $hook.description }}
    log_info "Running post-install hook for: {{ $hook.package }}"
    log_info "  Description: {{ $hook.description }}"

    local hook_failed=0
{{ range $cmd := $hook.commands }}
    log_info "  Executing: {{ $cmd }}"
    if eval "{{ $cmd }}"; then
        log_success "  Command succeeded"
    else
        local exit_code=$?
        log_error "  Command failed with exit code $exit_code"
        hook_failed=1
    fi
{{ end }}

    if [[ $hook_failed -eq 0 ]]; then
        ((hooks_succeeded++)) || true
        log_success "Hook completed successfully: {{ $hook.package }}"
    else
        ((hooks_failed++)) || true
        log_warn "Hook had failures: {{ $hook.package }} (but continuing)"
    fi
    echo ""

{{ end }}

    # Summary
    log_info "Post-install hooks completed"
    echo ""

    if [[ $hooks_succeeded -gt 0 ]]; then
        log_success "Succeeded: $hooks_succeeded hook(s)"
    fi

    if [[ $hooks_failed -gt 0 ]]; then
        log_warn "Failed: $hooks_failed hook(s)"
        return 1
    fi
}

install_packages_main() {
    log_info "Installing packages from packages.yaml..."

    # --- DYNAMIC PACKAGE ARRAY SELECTION FOR ANNOTATED LIST FORMAT ---
    # Determine device and os for filtering (device: 'all'|'desktop'|'laptop', os: 'all'|'omarchy').
    local device="all"
    local distro="all"
{{ if .isDesktop }}
    device="desktop"
{{ else if .isLaptop }}
    device="laptop"
{{ end }}
{{ if .isOmarchy }}
    distro="omarchy"
{{ end }}

    # Populate arrays: pacman_packages and aur_packages.
{{ $pkgs := (include ".chezmoidata/packages.yaml" | fromYaml).packages }}
    local pacman_packages=()
    local aur_packages=()
{{ range $pkg := $pkgs }}
{{ $matchesDevice := or (eq $pkg.device "all") (and (eq $pkg.device "desktop") $.isDesktop) (and (eq $pkg.device "laptop") $.isLaptop) }}
{{ $matchesOS := or (eq $pkg.os "all") (and (eq $pkg.os "omarchy") $.isOmarchy) }}
{{ if and (eq $pkg.source "pacman") $matchesDevice $matchesOS }}
    pacman_packages+=("{{ $pkg.name }}")
{{ end }}
{{ if and (eq $pkg.source "aur") $matchesDevice $matchesOS }}
    aur_packages+=("{{ $pkg.name }}")
{{ end }}
{{ end }}

    # Install pacman packages
    if [[ ${#pacman_packages[@]} -gt 0 ]]; then
        install_pacman "${pacman_packages[@]}"
    fi

    # Install AUR packages
    if [[ ${#aur_packages[@]} -gt 0 ]]; then
        if aur_helper=$(detect_aur_helper); then
            install_aur "$aur_helper" "${aur_packages[@]}"
        else
            log_warn "No AUR helper found (paru/yay). Skipping AUR packages."
            log_warn "Install paru or yay and run 'chezmoi apply' again."
        fi
    fi

    log_info "Package installation complete!"
}

main() {
    # Install packages first
    install_packages_main
    
    # Then run post-install hooks
    run_post_install_hooks
    
    log_success "Package installation and post-install hooks completed!"
}

main "$@"