#!/usr/bin/env bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
#
# Install packages from packages-*.yaml
# This script:
#   1. Filters packages by device + requires_de (template time)
#   2. Detects available package managers (runtime)
#   3. Installs packages per manager (runtime)
#
# The script runs automatically when any packages-*.yaml changes.
#
# Hashes (triggers re-execution if any file changes):
# packages-pacman.yaml: {{ include ".chezmoidata/packages-pacman.yaml" | sha256sum }}
# packages-aur.yaml: {{ include ".chezmoidata/packages-aur.yaml" | sha256sum }}
# packages-apt.yaml: {{ include ".chezmoidata/packages-apt.yaml" | sha256sum }}
# packages-bun.yaml: {{ include ".chezmoidata/packages-bun.yaml" | sha256sum }}

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_success() { echo -e "${BLUE}[✓]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

if [[ $EUID -eq 0 ]]; then
    log_error "Do not run this script as root"
    exit 1
fi

{{ if eq .chezmoi.os "windows" }}
log_info "Windows detected — use install-windows-packages.ps1 instead"
exit 0
{{ end }}

# --- Template-time: pre-filter package lists per manager ---
# Filtered by device + requires_de at template render time.
# Runtime checks handle already-installed detection.

{{ $device := .device }}
{{ $hasDE := .hasDE }}

{{ $pacmanPkgs := (include ".chezmoidata/packages-pacman.yaml" | fromYaml).packages }}
{{ $aurPkgs := (include ".chezmoidata/packages-aur.yaml" | fromYaml).packages }}
{{ $aptPkgs := (include ".chezmoidata/packages-apt.yaml" | fromYaml).packages }}
{{ $bunPkgs := (include ".chezmoidata/packages-bun.yaml" | fromYaml).packages }}

install_packages_main() {
    local pacman_packages=()
    local aur_packages=()
    local apt_packages=()
    local bun_packages=()
    local bun_packages_ignore_scripts=()

    # --- Generate filtered package arrays from templates ---
{{ range $pkg := $pacmanPkgs }}
{{ if or (eq $pkg.device "all") (eq $pkg.device $device) }}
{{ if or (not $pkg.requires_de) $hasDE }}
    pacman_packages+=("{{ $pkg.name }}")
{{ end }}
{{ end }}
{{ end }}

{{ range $pkg := $aurPkgs }}
{{ if or (eq $pkg.device "all") (eq $pkg.device $device) }}
{{ if or (not $pkg.requires_de) $hasDE }}
    aur_packages+=("{{ $pkg.name }}")
{{ end }}
{{ end }}
{{ end }}

{{ range $pkg := $aptPkgs }}
{{ if or (eq $pkg.device "all") (eq $pkg.device $device) }}
{{ if or (not $pkg.requires_de) $hasDE }}
    apt_packages+=("{{ $pkg.name }}")
{{ end }}
{{ end }}
{{ end }}

{{ range $pkg := $bunPkgs }}
{{ if or (eq $pkg.device "all") (eq $pkg.device $device) }}
{{ if or (not $pkg.requires_de) $hasDE }}
    bun_packages+=("{{ $pkg.name }}")
    bun_packages_ignore_scripts+=({{ if $pkg.ignore_scripts }}true{{ else }}false{{ end }})
{{ end }}
{{ end }}
{{ end }}

    # --- Runtime: detect managers and install ---

    if command -v pacman &>/dev/null; then
        log_info "pacman detected"
        local installed
        installed=$(pacman -Q --quiet 2>/dev/null || true)
        local to_install=()

        for pkg in "${pacman_packages[@]}"; do
            if ! grep -q "^${pkg}$" <(echo "$installed"); then
                to_install+=("$pkg")
            fi
        done

        if [[ ${#to_install[@]} -gt 0 ]]; then
            log_info "Installing ${#to_install[@]} pacman packages..."
            sudo pacman -S --needed --noconfirm "${to_install[@]}"
        else
            log_info "No new pacman packages to install"
        fi
    fi

    if command -v paru &>/dev/null || command -v yay &>/dev/null; then
        local aur_helper
        aur_helper=$(command -v paru || command -v yay)
        log_info "AUR helper detected: ${aur_helper##*/}"
        local installed_aur
        installed_aur=$(pacman -Qm --quiet 2>/dev/null || true)
        local to_install_aur=()

        for pkg in "${aur_packages[@]}"; do
            if ! grep -q "^${pkg}$" <(echo "$installed_aur"); then
                to_install_aur+=("$pkg")
            fi
        done

        if [[ ${#to_install_aur[@]} -gt 0 ]]; then
            log_info "Installing ${#to_install_aur[@]} AUR packages with ${aur_helper##*/}..."
            "$aur_helper" -S --needed --noconfirm "${to_install_aur[@]}"
        else
            log_info "No new AUR packages to install"
        fi
    elif [[ ${#aur_packages[@]} -gt 0 ]]; then
        log_warn "AUR packages defined but no AUR helper found (paru/yay). Skipping."
    fi

    if command -v apt &>/dev/null; then
        log_info "apt detected"
        local apt_installed
        apt_installed=$(dpkg-query -W -f '${Package}\n' 2>/dev/null || true)
        local to_install_apt=()

        for pkg in "${apt_packages[@]}"; do
            if ! grep -q "^${pkg}$" <(echo "$apt_installed"); then
                to_install_apt+=("$pkg")
            fi
        done

        if [[ ${#to_install_apt[@]} -gt 0 ]]; then
            log_info "Installing ${#to_install_apt[@]} APT packages..."
            sudo apt install -y "${to_install_apt[@]}"
        else
            log_info "No new APT packages to install"
        fi
    fi

    # --- Bun global packages (runs after package managers so bun itself is installed) ---
    if command -v bun &>/dev/null && [[ ${#bun_packages[@]} -gt 0 ]]; then
        log_info "bun detected"
        local installed_bun
        installed_bun=$(bun -g list 2>/dev/null | grep -oP '^\s*\- \K\S+' || true)

        for i in "${!bun_packages[@]}"; do
            pkg="${bun_packages[$i]}"
            if grep -q "^${pkg}$" <(echo "$installed_bun"); then
                continue
            fi
            if [[ "${bun_packages_ignore_scripts[$i]}" == "true" ]]; then
                log_info "Installing bun global package: $pkg (--ignore-scripts)"
                bun add -g --ignore-scripts "$pkg"
            else
                log_info "Installing bun global package: $pkg"
                bun add -g "$pkg"
            fi
        done
    elif [[ ${#bun_packages[@]} -gt 0 ]]; then
        log_warn "Bun packages defined but bun not found. Skipping."
    fi
}

main() {
    install_packages_main
    log_success "Package installation completed!"
}

main "$@"
